# ==============================================================================
# PathGen-AI Environment Variables Template
# Copy this file to '.env' in the root directory, 'backend/.env' and 'frontend/.env.local'
# ==============================================================================

# ─── DATABASE SETTINGS (BACKEND) ──────────────────────────────────────────────
# By default, connection.py uses SQLite local database pathgen.db.
# Uncomment PostgreSQL configuration if using Docker or production PostgreSQL.
DATABASE_URL=sqlite:///./pathgen.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/pathgen_db

# ─── DEBUG SETTINGS ───────────────────────────────────────────────────────────
DEBUG=True

# ─── CLERK AUTHENTICATION (BACKEND & FRONTEND) ────────────────────────────────
# Clerk Issuer URL is used by the backend to verify JWT tokens.
# Change 'amused-hawk-68' to your Clerk project's domain if necessary.
CLERK_ISSUER_URL=https://amused-hawk-68.clerk.accounts.dev
CLERK_SECRET_KEY=sk_test_NfvIf7itszxcKQTSKz1UiW7v4tUtTrFNaFwdiMnSK1

# Clerk Publishable Key (used by Frontend)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YW11c2VkLWhhd2stNjguY2xlcmsuYWNjb3VudHMuZGV2JA

# Clerk Sign In / Sign Up Frontend Route Redirects
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup

# ─── FRONTEND CONFIGURATION ───────────────────────────────────────────────────
# Base URL for Axios client in Next.js to connect to the FastAPI backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# ─── AI ENGINE / LLM CONFIGURATION (BACKEND) ──────────────────────────────────
# This project uses NVIDIA NIM but uses the OpenAI API client format.
# Replace this with your actual NVIDIA API Key (starts with nvapi-).
OPENAI_API_KEY=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
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL_NAME=meta/llama-3.3-70b-instruct

# ─── WEB SEARCH & RESOURCES (BACKEND) ─────────────────────────────────────────
# Firecrawl is used for web resource discovery (YouTube links, docs, etc.)
FIRECRAWL_API_KEY=fc-082565e258084ebc85bfcce4f0c38225
